# FinSpectra Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://finspectra:finspectra_dev@localhost:5432/finspectra

# For local SQLite fallback (used if DATABASE_URL is not set):
# DATABASE_URL=sqlite+aiosqlite:///./finspectra.db

# ============================================================
# SECURITY
# ============================================================
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ============================================================
# LLM (OPTIONAL)
# ============================================================
# The application works fully without an LLM key.
# If set, used for narrative generation in reports only.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=50

# ============================================================
# POSTGRES (for docker-compose)
# ============================================================
POSTGRES_USER=finspectra
POSTGRES_PASSWORD=finspectra_dev
POSTGRES_DB=finspectra
